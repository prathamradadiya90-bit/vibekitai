<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds enforce strict HTTPS-only transport. Debug and profile source sets
         provide separate configs for local emulator / LAN development servers. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
