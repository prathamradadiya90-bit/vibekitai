# ==============================================================================
# VibeKit AI — Backend Environment Configuration Example
# Copy this file to .env for local testing or set these via Cloudflare Secrets:
# `npx wrangler secret put GEMINI_API_KEY`
# `npx wrangler secret put GOOGLE_PLAY_SERVICE_ACCOUNT_JSON`
# ==============================================================================

# Server Environment (development | staging | production)
ENVIRONMENT=development

# Google Gemini API Key (Never commit real keys or expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
GEMINI_MODEL=gemini-1.5-flash

# Credit Quotas
MAX_DAILY_FREE_CREDITS=3
REWARD_CREDITS_PER_AD=3
MAX_DAILY_REWARDS=2
MONTHLY_PRO_CREDITS=200

# AdMob Server-Side Verification Secret / Key ID (Optional for local dev)
ADMOB_SSV_KEY_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Google Play Developer Service Account (Base64 or JSON string for server-side verification)
GOOGLE_PLAY_PACKAGE_NAME=com.vibekit.vibekit_ai
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
